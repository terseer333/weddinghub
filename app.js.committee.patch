// Add helper functions to WeddingHub export:
function committeeByToken(data = getData()) {
  const token = query("token");
  return data.committee?.members?.find(m => m.token === token);
}

function getCommitteeRole(data = getData()) {
  const token = query("token");
  const member = committeeByToken(data);
  return member?.status === "accepted" ? "committee_member" : null;
}

function getGuestRole(data = getData()) {
  const guest = guestByToken(data);
  return guest?.rsvp === "attending" ? "guest" : null;
}

// Export these new functions
window.WeddingHub.committeeByToken = committeeByToken;
window.WeddingHub.getCommitteeRole = getCommitteeRole;
window.WeddingHub.getGuestRole = getGuestRole;
